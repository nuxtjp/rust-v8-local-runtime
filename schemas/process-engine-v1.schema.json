{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nuxtjp://local-runtime/process-engine/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "worker_path",
    "worker_sha256",
    "expires_unix_seconds",
    "script_id",
    "script_sha256",
    "limits"
  ],
  "properties": {
    "schema": { "const": "nuxtjp://local-runtime/process-engine/v1" },
    "worker_path": { "type": "string", "pattern": "^/" },
    "worker_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "expires_unix_seconds": { "type": "integer", "minimum": 1 },
    "script_id": { "const": "nuxtjp-service-card-v1" },
    "script_sha256": {
      "const": "bd954b068b08f679b2c90c788b907100a184097693bbf24ddd119937d4119b8e"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_bytes", "output_bytes", "heap_mib", "timeout_ms"],
      "properties": {
        "input_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "output_bytes": { "type": "integer", "minimum": 1, "maximum": 262144 },
        "heap_mib": { "type": "integer", "minimum": 8, "maximum": 128 },
        "timeout_ms": { "type": "integer", "minimum": 10, "maximum": 10000 }
      }
    }
  }
}
