{
  "runtime_id": "nuxtjp-local-simulation",
  "subject_id": "local-device-simulation",
  "bind": "127.0.0.1:37843",
  "mode": "local-simulation",
  "external_actions": false,
  "external_egress": "deny",
  "engine_status": "simulated",
  "allowed_origins": [
    "http://127.0.0.1:3000",
    "https://nerp.jp"
  ],
  "limits": {
    "max_request_bytes": 16384,
    "max_response_bytes": 262144,
    "max_messages_per_minute": 60,
    "max_bytes_per_minute": 1048576,
    "session_ttl_seconds": 300
  },
  "capabilities": [
    {
      "id": "workflow.issue.read",
      "service_id": "constillo",
      "description": "ローカル課題の集計だけを表示する",
      "output_band": "session",
      "payload_schema": {
        "id": "nuxtjp.workflow-issue-summary.v1",
        "fields": [
          { "name": "open_count", "kind": "count" },
          { "name": "blocked_count", "kind": "count" },
          { "name": "source", "kind": "text" },
          { "name": "local_only", "kind": "boolean" }
        ]
      }
    },
    {
      "id": "ecosystem.summary.read",
      "service_id": "ecosystem-control",
      "description": "ローカル運営サマリーだけを表示する",
      "output_band": "session",
      "payload_schema": {
        "id": "nuxtjp.ecosystem-summary.v1",
        "fields": [
          { "name": "services_ready", "kind": "count" },
          { "name": "attention_count", "kind": "count" },
          { "name": "source", "kind": "text" },
          { "name": "local_only", "kind": "boolean" }
        ]
      }
    }
  ],
  "views": [
    {
      "capability_id": "workflow.issue.read",
      "view_id": "issue-summary",
      "band": "session",
      "payload_schema_id": "nuxtjp.workflow-issue-summary.v1",
      "payload": {
        "open_count": 2,
        "blocked_count": 1,
        "source": "local-simulation",
        "local_only": true
      }
    },
    {
      "capability_id": "ecosystem.summary.read",
      "view_id": "ecosystem-summary",
      "band": "session",
      "payload_schema_id": "nuxtjp.ecosystem-summary.v1",
      "payload": {
        "services_ready": 4,
        "attention_count": 3,
        "source": "local-simulation",
        "local_only": true
      }
    }
  ]
}
